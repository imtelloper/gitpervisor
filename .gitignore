# Claude Code 로컬 캐시 — settings.local.json 등은 무시하되, 저장소 전용 스킬
# (.claude/skills/*)은 팀이 공유해야 하므로 추적한다.
# 주의: 디렉터리 자체를 무시하면 하위를 다시 포함할 수 없어 `.claude/*` 형태여야 한다.
.claude/*
!.claude/skills/

# 번들 도구 바이너리(재현: npm run fetch-tools) — git에 커밋하지 않음
src-tauri/resources/tools/ruff*
src-tauri/resources/tools/biome*
# 번들 ConPTY 바이너리(재현: npm run fetch-tools -- conpty) — LICENSE/README만 커밋
src-tauri/resources/conpty/**/*.dll
src-tauri/resources/conpty/**/*.exe

# 동영상 기능 수동 확인용 샘플 — 코드가 참조하지 않는 스크래치 파일이라 커밋하지 않는다.
test-media/

# tsc/vite가 남기는 부산물 — 커밋 대상이 아니다
tsconfig.tsbuildinfo
tsconfig.node.tsbuildinfo
vite.config.js
vite.config.d.ts

# pdf.js 정적 자산 — predev/prebuild가 node_modules/pdfjs-dist에서 복사한다(scripts/copy-pdfjs-assets.mjs)
/public/pdfjs/
